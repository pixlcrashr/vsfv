{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: serve (debug)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["serve", "--config", "${workspaceFolder}/config.dev.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Frontend: Serve Mock (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    },
    {
      "name": "Frontend: Serve API (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web:serve:api",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    },
    {
      "name": "Frontend: Test (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web:test",
      "url": "http://localhost:9876/debug.html"
    }
  ]
}
